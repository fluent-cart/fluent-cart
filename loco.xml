<?xml version="1.0" encoding="utf-8"?>
<!--
  Loco Translate bundle configuration.

  Without this file Loco guesses the bundle layout, and its scan picks up any
  .po/.mo it finds anywhere under the plugin. That pulls in translation files
  belonging to composer dev-dependencies (notably
  dev/wp-browser/vendor/lucatume/wp-browser/.../airplane-mode/languages/), which
  makes Loco report the bundle as "not fully configured" and offer unrelated
  files for editing.

  Declaring the layout explicitly also keeps test and tooling strings out of the
  POT: dev/ContainerScript and the wp-browser integration tests were
  contributing msgids that translators had no business seeing.
-->
<bundle name="FluentCart" min-version="2.0.14">
  <domain name="fluent-cart">
    <project name="FluentCart" slug="fluent-cart">
      <!-- Only these carry gettext calls. resources/ is deliberately absent:
           JS strings reach translators via app/Services/Translations/*.php,
           which are generated by `npm run translate` precisely so a PHP-only
           scanner can see them. -->
      <source>
        <directory>app</directory>
        <directory>api</directory>
        <directory>database</directory>
        <exclude>
          <directory>app/Services/Libs</directory>
        </exclude>
      </source>
      <target>
        <directory>language</directory>
      </target>
      <template>
        <file>language/fluent-cart.pot</file>
      </template>
    </project>
  </domain>
  <exclude>
    <directory>dev</directory>
    <directory>tests</directory>
    <directory>vendor</directory>
    <directory>node_modules</directory>
    <directory>resources</directory>
    <directory>assets</directory>
    <directory>dummies</directory>
  </exclude>
</bundle>
