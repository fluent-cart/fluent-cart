# FluentCart Browser Tests — Environment Config
# Copy this file to .env and fill in your values:
#   cp tests/playwright/.env.example tests/playwright/.env

# WordPress site URL
WP_URL=https://wp.test

# Admin credentials
WP_USER=admin
WP_PASS=

# Checkout URL with items in cart (for checkout tests)
# Get this by adding a product to cart and copying the URL
CHECKOUT_URL=

# Browser mode: false = headless (default), true = show the browser window.
# Prefer the flag over this switch — `npm test -- playwright --headed` is per-run,
# and works with any engine. A `true` here makes every run headed, forever.
HEADED=false

# Pace: ms between actions in headed mode (default: 500)
# Set higher (1500) to watch comfortably, 0 for fast
PACE=500

# Chromium path (auto-detected from Playwright cache if not set)
# CHROMIUM_PATH=/path/to/chromium

# CI mode: skips prompts, uses env vars only
# CI=true
